  "_about": "Hand-written Ollama /api/chat message.content values. Expectations were worked out by hand from the sources, not by running the validator. 'output' is serialized to JSON as the model content; 'content' is used verbatim. The generator (kept out of the repo) only attaches the id/step keys to the hand-written texts.",
  "sources": {
    "shrimp": {
      "title": "Garlic Butter Shrimp",
      "ingredients": [
        {
          "id": "ing_0000000000000000000000SH01",
          "text": "1 lb shrimp, peeled"
        },
        {
          "id": "ing_0000000000000000000000SH02",
          "text": "3 tbsp butter (unsalted)"
        },
        {
          "id": "ing_0000000000000000000000SH03",
          "text": "4 cloves garlic, minced"
        },
        {
          "id": "ing_0000000000000000000000SH04",
          "text": "½ tsp salt"
        },
        {
          "id": "ing_0000000000000000000000SH05",
          "text": "1-2 tbsp fresh parsley, chopped"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Melt the butter in a large pan over medium heat."
        },
        {
          "step": 2,
          "text": "Add the garlic and cook for 1 minute."
        },
        {
          "step": 3,
          "text": "Add the shrimp and cook 2-3 minutes per side."
        }
      ]
    },
    "flatbread": {
      "title": "Skillet Flatbread",
      "ingredients": [
        {
          "id": "ing_0000000000000000000000BR01",
          "text": "two cups flour"
        },
        {
          "id": "ing_0000000000000000000000BR02",
          "text": "a pinch of salt"
        },
        {
          "id": "ing_0000000000000000000000BR03",
          "text": "1 cup warm water"
        },
        {
          "id": "ing_0000000000000000000000BR04",
          "text": "olive oil"
        },
        {
          "id": "ing_0000000000000000000000BR05",
          "text": "flaky salt"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Mix the flour and salt."
        },
        {
          "step": 2,
          "text": "Stir in the water and knead for two minutes."
        },
        {
          "step": 3,
          "text": "Rest the dough for twenty-five minutes."
        },
        {
          "step": 4,
          "text": "Cook in an oiled pan."
        },
        {
          "step": 5,
          "text": "Sprinkle with flaky salt."
        }
      ]
    }
  },
